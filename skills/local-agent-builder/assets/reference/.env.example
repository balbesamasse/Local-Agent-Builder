# ============================================================
#  OpenGravity — configuration
#  Copier ce fichier en `.env` puis remplir les valeurs.
#  `.env` est dans .gitignore : il ne doit JAMAIS être committé.
# ============================================================

# --- Fichier de variables ----------------------------------
# Chemin relu par l'agent quand il est lancé sans --env-file (npm start, node dist/...).
# Une variable déjà exportée dans l'environnement gagne toujours : ce fichier ne fait
# que combler les absences. Le mettre à /dev/null dans un conteneur à secrets injectés,
# une CI, ou un test — c'est ce que font les tests bout-en-bout du projet, pour qu'aucun
# .env local ne puisse leur faire appeler un fournisseur payant.
ENV_FILE=".env"

# --- Telegram (obligatoire) --------------------------------
# Token obtenu via @BotFather
TELEGRAM_BOT_TOKEN="REMPLACEZ_PAR_LE_VOTRE"
# Liste blanche d'IDs Telegram, séparés par des virgules.
# Récupérez le vôtre en écrivant /id à votre bot.
TELEGRAM_ALLOWED_USER_IDS="123456789"
# À passer à false une fois l'installation faite (voir docs/SECURITY.md).
TELEGRAM_ID_COMMAND_ENABLED="true"

# --- LLM principal : Groq ---------------------------------
GROQ_API_KEY="REMPLACEZ_PAR_LE_VOTRE"
# ⚠ Les identifiants de modèles sont propres à CHAQUE COMPTE : la doc d'un modèle
# ne garantit pas qu'il soit disponible chez toi. Liste les tiens avant de remplir :
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" \
#        https://api.groq.com/openai/v1/models | grep -o '"id":"[^"]*"'
# Deux noms qui n'existaient pas sur le compte de référence ont été corrigés en
# ceux-ci, vérifiés le 2026-09-02 avec un appel d'outil réel.
GROQ_MODEL="openai/gpt-oss-120b"
# Second modèle Groq essayé si le premier est plafonné (429/503). Vide = désactivé.
GROQ_FALLBACK_MODEL="qwen/qwen3.8-27b"
# Vérifier au démarrage que ces deux IDs existent chez le fournisseur (1 requête).
# À couper seulement hors ligne : un modèle introuvable sinon ne se voit qu'au
# premier message, sous forme d'erreur 400 opaque.
LLM_VALIDATE_MODELS="true"

# --- LLM de secours optionnel : OpenRouter ----------------
# Laisser la clé vide désactive totalement OpenRouter (aucun appel réseau).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# --- Voix : écouter et parler --------------------------------
# Le mode décide QUAND une réponse a droit à un vocal (la facture ElevenLabs est à la
# voix, pas à la requête) :
#   mirror      on répond en vocal si TU as envoyé un vocal (défaut, prévisible)
#   always      chaque réponse a son audio
#   on_request  seulement si tu écris « envoie-moi ça en vocal »
#   off         désactivé à la source : aucun appel réseau de ce côté
VOICE_MODE="mirror"
# Une clé ici active les DEUX côtés (Scribe pour entendre, TTS pour parler).
# Vide = ElevenLabs totalement désactivé : la transcription retombe sur Groq seul.
ELEVENLABS_API_KEY=""
# L'identifiant de voix est propre à ton compte — mais inutile d'aller le chercher à la
# main dans un terminal : cette valeur n'est que le DEFAUT au démarrage. `/voice` liste les
# voix du compte directement dans Telegram, et le choix est persisté par conversation
# (colonne `chats.voice_id`) ; `/voice par-defaut` rend la main à ce fichier.
# Il est quand même vérifié au démarrage, comme les modèles de texte : une voix qui n'existe
# pas sur le compte est dite avant le premier message, pas après facture.
ELEVENLABS_VOICE_ID=""
# Idem pour les modèles : GET /v1/models liste ceux de ton abonnement.
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"
ELEVENLABS_STT_MODEL="scribe_v1"
# Expression (0 = très expressif, 100 = très stable) et proximité à la voix d'origine.
ELEVENLABS_STABILITY="50"
ELEVENLABS_SIMILARITY="75"
# Transcription : ordre de bascule. Groq utilise la clé déjà présente pour le texte.
TRANSCRIPTION_PROVIDERS="groq,elevenlabs"
GROQ_WHISPER_MODEL="whisper-large-v3"
# Budget de synthèse par réponse, en caractères (au-delà : coupure sur fin de phrase,
# et la réponse texte intégrale est envoyée de toute façon).
TTS_MAX_CHARS="1200"
# Plafond absolu d'un fichier reçu. Telegram tolère 20 Mo ; on laisse 8 Mo, un vocal
# correct tient largement dessous, et un gros fichier évité est un OOM évité.
MEDIA_MAX_BYTES="8388608"

# --- Google Workspace (Gmail, Drive, Docs, Sheets, Calendar) -------------------
# L'agent peut lire et chercher dans les services Google du compte qui a ete connecte,
# via le CLI officiel `gws` (installe comme dependance du projet : `npm install` suffit).
#
# Ce qui a ete VERIFIE sur le binaire avant de concevoir, et non suppose :
#   - `gws mcp` n'existe pas : la sous-commande MCP a ete retiree du CLI en v0.8.0
#     (`gws mcp` rend « Unknown service 'mcp' » sur la 0.22.5 installable aujourd'hui).
#     Le trajet retenu est donc le CLI par processus fils : pas de port, pas de demon,
#     et chaque appel est verifiable localement avec --dry-run ;
#   - le CLI lit GOOGLE_APPLICATION_CREDENTIALS (ADC) AVANT son propre magasin : une cle
#     declaree pour autre chose et pointant vers un fichier absent fait echouer TOUTE
#     l'authentification. Cette cle n'est donc plus declaree nulle part ici, et le projet
#     la refuse explicitement (voir src/google/gws-cli-transport.ts) ;
#   - `gws auth status` rend un code de sortie 0 meme sans compte : l'etat se lit dans le
#     corps de la reponse, jamais dans le code de sortie ;
#   - une methode REST rend {"error":{"code":401,...}}, un helper rend {"error":{"code":0,
#     "reason":"...","message":"<json echappe>"}} : les deux formes sont traitees.
#
# 1) GOOGLE_ENABLED=false : aucun outil Google n'est declare au modele. C'est le defaut :
#    un agent qui peut lire ta boite mail n'est pas un agent qu'on active par accident.
# 2) La connexion du compte est HUMAINE et se fait sur la machine de l'agent :
#       npm run google:setup   (une fois : projet GCP + client OAuth + ecran de consentement)
#       npm run google:login   (navigateur, Choix des services)
#    Aucun mot de passe, aucun client_secret, aucun token ne transite par Telegram ni
#    n'entre dans le depot : les credentials restent dans ~/.config/gws, chifffres.
# 3) Les ecritures (envoyer un mail, creer un evenement, ecrire dans une feuille, supprimer
#    un fichier) demandent DEUX verrous actifs — GWS_ALLOW_WRITES=true et
#    DANGEROUS_TOOLS_ENABLED=true — plus un clic de confirmation dans Telegram a chaque fois.
GOOGLE_ENABLED="false"
# `gws` du PATH, ou celui du depot (node_modules/.bin est cherche en premier).
GWS_BIN="gws"
# Liste blanche : un service hors de cette liste n'a aucun outil, et l'appel est refuse.
# Autorises : gmail, drive, docs, sheets, calendar, tasks.
GWS_SERVICES="gmail,drive,docs,sheets,calendar"
# false = lecture seule, meme si DANGEROUS_TOOLS_ENABLED est vrai.
GWS_ALLOW_WRITES="false"
# Un appel Google lent ne doit pas rendre l'agent poli mais muet : au-dela, le fils est tué
# (SIGTERM, puis SIGKILL 1,5 s apres) et la reponse explique ce qui a ete coupe.
GWS_TIMEOUT_MS="20000"
# Plafond d'octes lus sur la sortie du CLI. Un drive_read_text sur un fichier de 200 Mo
# doit echouer ici, pas en memoire.
GWS_MAX_OUTPUT_BYTES="400000"
# Les quotas Google sont par utilisateur : 2 appels en parallel, les autres font la queue.
GWS_MAX_IN_FLIGHT="2"
# Tentatives pour une LECTURE (1 = aucun rejeu). Une ECRITURE n'est jamais rejouee : sur une
# deconnexion on ne sait pas si Google a applique, et rejeuer un envoi ferait deux mails.
GWS_READ_ATTEMPTS="2"
# Vide = magasin du CLI (~/.config/gws, alimente par `gws auth login`). Ne mets JAMAIS un
# token en clair ici : si tu dois pointer un fichier, c'est un chemin, pas un secret.
GWS_CREDENTIALS_FILE=""
# keyring = trousseau de l'OS (macOS, postes connectes). file = serveur sans trousseau :
# la cle d'chiffrement atterrit dans ~/.config/gws/.encryption_key, a proteger en 600.
GWS_KEYRING_BACKEND="keyring"
# Projet GCP pour le quota et la facturation. Vide = celui du client OAuth cree au setup.
GWS_PROJECT_ID=""

# --- Appel vocal en direct (Live Voice) --------------------------------
# L'agent parle et écoute EN CONTINU pendant un appel — pas des notes vocales avant/après.
# Contrainte structurante verifiee sur la documentation officielle : l'API Bot de Telegram ne
# transporte AUCUN media d'appel (les types d'appel vocal ont ete retires en 2022) et ne peut
# pas lire le micro. Le trajet officiellement possible est donc : le bot sert lui-meme une page
# d'appel, et cette page ouvre un websocket avec lui. D'ou le seul port du projet.
#
# 1) REALTIME_ENABLED=false : rien n'est ecoute, aucun port, et /call explique pourquoi.
#    C'est le defaut — un micro ouvert par accident n'est pas un detail de configuration.
# 2) REALTIME_BIND=127.0.0.1 : sur un autre réseau, le lien sort de la machine. Mettre
#    0.0.0.0 veut dire « n'importe qui sur mon LAN peut parler a mon agent avec mes cles ».
# 3) Le micro n'est autorise par les navigateurs qu'en HTTPS ou sur localhost. En local
#    (http://127.0.0.1), ca marche. Des que REALTIME_PUBLIC_URL est un nom de domaine, il
#    faut du https:// devant — sinon la page s'ouvre et le micro est refuse sans explication.
REALTIME_ENABLED="false"
REALTIME_PORT="8790"
REALTIME_BIND="127.0.0.1"
# Lien affiche dans Telegram (le jeton est emis a chaque /call, jamais stocke en clair).
# Laisser vide = http://<REALTIME_BIND>:<REALTIME_PORT>.
REALTIME_PUBLIC_URL=""
# Plafonds d'un appel. Deux factures par tour (STT + TTS) : un appel de 25 minutes avec un
# modele bavard est le seul moyen de decouvrir ces lignes par la facture, donc elles existent.
REALTIME_MAX_MINUTES="10"
REALTIME_MAX_TURNS="40"
# Duree de vie du lien de connexion : a usage unique, purged a l'echeance. Assez long pour
# copier-coller dans un telephone, assez court pour qu'un lien perdu ne soit pas un micro ouvert.
REALTIME_TICKET_TTL_SECONDS="120"
# Silence qui clot un tour de parole (ms). 450 = reactive sans hacher la phrase ; au-dessus
# de ~700 l'agent parait lent a repondre, en dessous de ~300 il coupe des « euh… ».
REALTIME_VAD_SILENCE_MS="450"
# Debit montant par client (kilobits/s de PCM16 16 kHz = 256kbps reel). Un client regle sur
# 48 kHz stereo depasse et le hub lache des trames en le disant, au lieu de saturer un
# fournisseur facture a la seconde.
REALTIME_MAX_KBPS="128"
# Transcription temps reel (websocket, commit manuel : c'est le VAD local qui decide la fin
# de tour, pas le fournisseur — sinon changer de fournisseur changerait le rythme).
REALTIME_STT_MODEL="scribe_v2_realtime"
# Voix pendant l'appel : modele distinct de celui des vocaux, choisi pour la latence.
REALTIME_TTS_MODEL="eleven_flash_v2_5"
# Base websocket du fournisseur de voix (parallele a ELEVENLABS_BASE_URL, qui est http).
# Un relais ou un proxy local se declare ici ; vide = wss://api.elevenlabs.io/v1.
ELEVENLABS_WS_URL="wss://api.elevenlabs.io/v1"

# --- Persistance -------------------------------------------
# --- Journal ---
# Journal applicatif EN PLUS de stdout. Laisser vide = stdout uniquement (c'est le défaut,
# et c'est ce qui garde les tests sans effet de bord sur le dépôt). Il sert à une seule
# chose : retrouver la cause d'un arrêt quand le terminal qui a vu mourir le bot est fermé.
# Borné : 4 Mio puis rotation en .1 (une seule archive — un journal infini est un incident
# de disque annoncé).
LOG_FILE="./logs/agent.log"

DB_PATH="./memory.db"

# --- Comportement de l'agent -------------------------------
# DEBUG=1 ajoute les détails de tour (itérations, outils) aux journaux.
DEBUG="0"
AGENT_NAME="OpenGravity"
AGENT_MAX_ITERATIONS="6"
# À partir de cette itération les outils sont retirés pour forcer une réponse (0 = jamais).
AGENT_FORCE_FINAL_ITERATION="5"
SYSTEM_TIMEZONE="Africa/Bamako"
HISTORY_LIMIT="40"
MAX_MESSAGE_CHARS="6000"
MAX_MEMORY_ITEMS="500"
LLM_TIMEOUT_MS="60000"
LLM_MAX_RETRIES="2"

# --- Sécurité ----------------------------------------------
RATE_LIMIT_BURST="20"
RATE_LIMIT_PER_MIN="12"
APPROVAL_TTL_MINUTES="15"
WORKSPACE_ROOT="."
# Portail global : true est nécessaire (mais pas suffisant) pour qu'un outil
# marqué « sensible » (shell, écriture disque…) soit enregistré.
DANGEROUS_TOOLS_ENABLED="false"

# --- Points de terminaison (ne toucher que pour un relais / un test) --
# Vide = api.telegram.org, api.groq.com et api.elevenlabs.io.
TELEGRAM_API_ROOT=""
GROQ_BASE_URL=""
OPENROUTER_BASE_URL=""
ELEVENLABS_BASE_URL="https://api.elevenlabs.io/v1"

# --- Compte de service (option d'architecture, non câblée) ----------------------
# `service-account.json.example` montre la FORME d'une clé privée de compte de service
# (server-to-server, avec délégation d'administration). Il n'est pas câblé : le trajet
# retenu pour lire Gmail ou Drive est le compte personnel connecté par OAuth
# (`GOOGLE_ENABLED` + `npm run google:login`), parce qu'un compte de service ne VOIT pas
# la boîte d'un utilisateur sans délégation — et que cette délégation ne se configure que
# dans un Workspace d'entreprise.
#
# LA CLÉ `GOOGLE_APPLICATION_CREDENTIALS` N'EST PLUS DÉCLARÉE ICI, et c'est une correction,
# pas un nettoyage : elle était listée « pour le contrat » alors que rien ne la lisait dans
# le projet — mais `gws`, lui, la lit. Un pointeur vers un fichier absent lui faisait
# refuser toute la chaîne d'authentification, avec une erreur qui ne nommait ni `gws`, ni
# cette variable. Une clé déclarée mais inactive n'est pas inerte : elle devient active au
# premier outil qui partage le préfixe de son fournisseur.
